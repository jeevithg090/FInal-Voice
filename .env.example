# Copy to .env (next to piper_ta_rocm71_train.sh) and adjust. Every variable is
# optional; the values shown are the defaults. Variables already set in the
# shell take precedence over .env. Values are read literally: no $VAR expansion.

# --- Paths ---
# WORK_ROOT=/scratch/piper_tamil          # falls back to /opt/piper_tamil if /scratch is not mounted
# DATA_ZIP_DIR=/root/tamil_female_mono     # default: $HOME/tamil_female_mono
# DATASET_ARCHIVE=/root/tamil_female_mono/tamil_female_mono.zip
# PIPER_REPO_DIR=/scratch/piper_tamil/piper1-gpl

# --- Sources ---
# Google Drive download URL of tamil_female_mono.zip (must contain the IndicTTS
# Phase2/Phase3 Tamil female mono zips). Point this at your own licensed copy.
# DATASET_URL=https://drive.usercontent.google.com/download?id=<FILE_ID>&export=download&authuser=0
# PIPER_REPO_URL=https://github.com/OHF-Voice/piper1-gpl.git
# TORCH_INDEX_URL=https://download.pytorch.org/whl/rocm7.1
# BASE_CKPT_URL=https://huggingface.co/datasets/rhasspy/piper-checkpoints/resolve/main/te/te_IN/maya/medium/epoch%3D3277-step%3D839202.ckpt

# --- Voice ---
# VOICE_NAME=ta_IN_iitm_female_s1
# MODEL_BASENAME=ta_IN-iitm-female-s1-medium
# ESPEAK_VOICE=ta

# --- Training ---
# INCLUDE_ADDITIONAL=0                     # 1 = also use Phase2 Additional_data
# BATCH_SIZE=48
# MAX_STEPS=120000                         # treated as additional steps if <= base checkpoint step
# VAL_SPLIT=0.05
# NUM_TEST_EXAMPLES=16
# PRECISION=bf16-mixed                     # 16-mixed, 32-true
# VAL_CHECK_INTERVAL=50
# MIN_ROWS=3000                            # abort if fewer utterances are found

# --- Host setup ---
# SKIP_APT=0                               # 1 = skip apt-get install
# SETUP_SCRATCH=1                          # 0 = never touch /etc/fstab or mount /scratch
